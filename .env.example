# Scoop App - Environment Configuration
# Copy this file to .env or .env.local and fill in your keys.

# ==========================================
# 1. NEON POSTGRES DATABASE
# ==========================================
# Get your connection string from https://console.neon.tech
DATABASE_URL="postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# 2. GROQ AI EXTRACTION API
# ==========================================
# Get your free API key from https://console.groq.com
GROQ_API_KEY="gsk_..."
GROQ_MODEL="openai/gpt-oss-120b"

# ==========================================
# 3. CLERK AUTHENTICATION (OPTIONAL)
# ==========================================
# Get keys from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ==========================================
# 4. CONNECTORS (COMPOSIO)
# ==========================================
# The only thing the Google Calendar connector needs. Create an API key at
# https://app.composio.dev — SCOOP creates the Google Calendar auth config
# itself using Composio's managed OAuth, so there is nothing else to set up.
COMPOSIO_API_KEY="..."

# Optional. Set this only to use your own Google OAuth app, so the consent
# screen shows your app name instead of Composio's. Create the auth config in
# the Composio dashboard and paste its id (starts with "ac_").
# COMPOSIO_GCAL_AUTH_CONFIG_ID="ac_..."
# ==========================================
# 5. SEO
# ==========================================
# Public origin used for canonical + Open Graph URLs (no trailing slash)
VITE_SITE_URL="https://scoop.yourdomain.com"
