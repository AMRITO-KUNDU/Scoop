# Scoop App - Environment Configuration
# Copy this file to .env or .env.local and fill in your keys.

# ==========================================
# 1. NEON POSTGRES DATABASE
# ==========================================
# Get your connection string from https://console.neon.tech
DATABASE_URL="postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# 2. GROQ AI EXTRACTION API
# ==========================================
# Get your free API key from https://console.groq.com
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.3-70b-versatile"

# ==========================================
# 3. CLERK AUTHENTICATION (OPTIONAL)
# ==========================================
# Get keys from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ==========================================
# 4. GOOGLE CLOUD OAUTH (DIRECT GOOGLE SIGNUP/LOGIN)
# ==========================================
# Get OAuth 2.0 Credentials from https://console.cloud.google.com
GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# ==========================================
# 5. XAI GROK API BACKUP (OPTIONAL)
# ==========================================
# Injected automatically in sandbox or get from https://console.x.ai
XAI_API_KEY=""

# ==========================================
# 6. BETTER AUTH SECRET / URL (OPTIONAL OVERRIDES)
# ==========================================
# BETTER_AUTH_SECRET="your-32-byte-secret-key"
# BETTER_AUTH_URL="http://localhost:8080"
