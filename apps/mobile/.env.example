# SCOOP mobile — environment
#
# Copy to .env and fill in. Only EXPO_PUBLIC_* values reach the app bundle, so
# never put a secret here.

# Clerk publishable key. This is a public key, but it must be passed explicitly
# to ClerkProvider — environment variables inside node_modules are not inlined
# in production React Native builds.
# Also: enable the Native API on the "Native applications" page in the Clerk
# dashboard, and register the iOS bundle identifier + Android package name
# (com.amritokundu.scoop) there. Without that, sign-in fails in a production
# build even though it works in development.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Where the backend lives. The mobile app talks to the JSON API in apps/web
# (src/routes/api/*), not to the web app's server functions, which are
# same-origin RPC and not callable from a native client.
# Point this at your deployed web app; use your LAN address while developing.
EXPO_PUBLIC_API_URL="https://scoopfamily.xyz"
